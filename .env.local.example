CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_webhook_signing_secret"
DATABASE_URL="postgresql://postgres:your-password-here@localhost:5432/unstack-learning"
FRONTEND_BASE_URL="http://localhost:3001"
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
VAPID_PUBLIC_KEY="your-vapid-public-key (web-push generate-vapid-keys)"
VAPID_PRIVATE_KEY="your-vapid-private-key (web-push generate-vapid-keys)"
VAPID_SUBJECT="mailto:you@example.com"
# Cloudflare R2 (media uploads). Create a bucket-scoped R2 API token:
# R2 → Manage R2 API Tokens → Object Read & Write, scoped to R2_BUCKET.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="unstack-learning-media"
