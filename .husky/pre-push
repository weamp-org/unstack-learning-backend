# Block direct pushes to main: main only moves via develop -> main PRs.
# Bypass with git push --no-verify (not recommended).
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are not allowed. Open a develop -> main PR instead." >&2
    exit 1
  fi
done
exit 0
