generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id    String @id
  name  String
  email String @unique

  role UserRole @default(STUDENT)

  teachingSubjects TeacherSubject[]
  availability     TeacherAvailability[]
  helpRequests     HelpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  teachers TeacherSubject[]
  helpRequests HelpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Links teachers to the subjects they can help with. Pure link table: no
/// timestamps, no metadata — extend explicitly if that need arrives.
model TeacherSubject {
  teacherId String
  subjectId String
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
}

/// One weekly availability window for a teacher. Times are HH:MM in the
/// window's timezone; matching logic converts to UTC when answering
/// "available now". Overnight windows (end <= start) are not supported.
model TeacherAvailability {
  id        String @id @default(cuid())
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  timezone  String @default("Africa/Accra")
}

/// A learner's request for help. Text + links in v1; media attachments arrive
/// with the object-storage slice.
model HelpRequest {
  id        String   @id @default(cuid())
  learnerId String
  learner   User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic     String
  details   String?
  links     HelpLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId])
  @@index([subjectId])
}

model HelpLink {
  id        String      @id @default(cuid())
  requestId String
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String
  label     String?

  @@index([requestId])
}
