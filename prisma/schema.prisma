generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id    String @id
  name  String
  email String @unique

  role UserRole @default(STUDENT)

  teachingSubjects TeacherSubject[]
  availability     TeacherAvailability[]
  availabilityOverrides TeacherAvailabilityOverride[]
  helpRequests     HelpRequest[]         @relation("LearnerRequests")
  assignedRequests HelpRequest[]        @relation("AssignedTeacher")
  requestDecisions HelpRequestDecision[]
  notifications    Notification[]       @relation("NotificationRecipient")
  triggered        Notification[]       @relation("NotificationActor")
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  teachers TeacherSubject[]
  helpRequests HelpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Links teachers to the subjects they can help with. Pure link table: no
/// timestamps, no metadata — extend explicitly if that need arrives.
model TeacherSubject {
  teacherId String
  subjectId String
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
}

/// One weekly availability window for a teacher. Times are HH:MM in the
/// window's timezone; matching logic converts to UTC when answering
/// "available now". Overnight windows (end <= start) are not supported.
model TeacherAvailability {
  id        String @id @default(cuid())
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  timezone  String @default("Africa/Accra")
}

/// A one-off exception to the weekly pattern. Dates are YYYY-MM-DD in the
/// override's own timezone; matching checks the override first — an
/// UNAVAILABLE covering now always wins, an AVAILABLE covering now beats a
/// closed schedule — and falls back to TeacherAvailability otherwise.
/// Past rows are purged on read, so the table only holds today + future.
enum AvailabilityOverrideKind {
  AVAILABLE
  UNAVAILABLE
}

model TeacherAvailabilityOverride {
  id        String                   @id @default(cuid())
  teacherId String
  teacher   User                     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      String
  startTime String
  endTime   String
  timezone  String                   @default("Africa/Accra")
  kind      AvailabilityOverrideKind

  @@index([teacherId])
}

/// A learner's request for help. Text + links in v1; media attachments arrive
/// with the object-storage slice.
model HelpRequest {
  id        String   @id @default(cuid())
  learnerId String
  learner   User     @relation("LearnerRequests", fields: [learnerId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic     String
  details   String?
  links     HelpLink[]
  status    HelpRequestStatus @default(OPEN)
  teacherId String?
  teacher   User?    @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  decisions HelpRequestDecision[]
  session   HelpSession?
  feedback  HelpFeedback?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId])
  @@index([subjectId])
  @@index([status])
}

enum HelpRequestStatus {
  OPEN
  ACCEPTED
  CLOSED
}

/// One teacher's verdict on a request. Declines stay per-teacher so the
/// request remains open for the other subject teachers; accepts flip the
/// global status in the same transaction.
model HelpRequestDecision {
  id        String       @id @default(cuid())
  requestId String
  request   HelpRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  decision  HelpDecision
  createdAt DateTime     @default(now())

  @@unique([requestId, teacherId])
  @@index([teacherId])
}

enum HelpDecision {
  ACCEPTED
  DECLINED
}

/// The arranged help session. Links are pasted by hand by the teacher —
/// any meeting platform works (Zoom, Meet, etc). Manual links are the
/// approach until further notice.
model HelpSession {
  id          String            @id @default(cuid())
  requestId   String            @unique
  request     HelpRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sessionUrl  String?
  scheduledAt DateTime?
  source      HelpSessionSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HelpSessionSource {
  MANUAL
  GOOGLE
}

model HelpLink {
  id        String      @id @default(cuid())
  requestId String
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String

  @@index([requestId])
}

/// Optional learner feedback after the session. One row per request,
/// created by the learner once ACCEPTED; visible to the learner, the
/// assigned teacher, and admins.
model HelpFeedback {
  id        String      @id @default(cuid())
  requestId String      @unique
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One browser/device push endpoint for a user. A user can have many (phone
/// + laptop); an endpoint belongs to whoever subscribed last on that device.
model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())

  @@index([userId])
}

/// An in-app inbox row for one recipient. REQUEST_CREATED fans out to the
/// eligible subject teachers (+ admins, with the availability rule applied);
/// REQUEST_ACCEPTED / SESSION_UPDATED go to the learner; FEEDBACK_CREATED
/// goes to the assigned teacher. Escalation reuses
/// REQUEST_CREATED so the (recipient, request, type) unique keeps it to one
/// row per teacher even when the suppressed group is notified late.
enum NotificationType {
  REQUEST_CREATED
  REQUEST_ACCEPTED
  SESSION_UPDATED
  FEEDBACK_CREATED
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  requestId   String
  request     HelpRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  /// Set when the recipient archives the row. Archived rows stay out of the
  /// inbox (and the unread count) but keep the unique key, so a repeat event
  /// cannot resurrect something the recipient put away. Purged after 30 days.
  archivedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([recipientId, requestId, type])
  @@index([recipientId])
  @@index([recipientId, archivedAt])
  @@index([requestId])
}
